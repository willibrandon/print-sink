<psf2:PrintDeviceCapabilities xmlns:psf2="http://schemas.microsoft.com/windows/2013/12/printing/printschemaframework2" xmlns:printsink="https://schemas.printsink.dev/printing/keywords" xmlns:psf="http://schemas.microsoft.com/windows/2003/08/printing/printschemaframework" xmlns:psk="http://schemas.microsoft.com/windows/2003/08/printing/printschemakeywords" xmlns:psk12="http://schemas.microsoft.com/windows/2013/12/printing/printschemakeywordsv12" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <psk:PageMediaSize psf2:psftype="Feature">
    <psk:NorthAmericaLetter psf2:psftype="Option" psf2:default="true">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,215900,279400</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">279400</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">215900</psk:MediaSizeWidth>
    </psk:NorthAmericaLetter>
    <printsink:Receipt80Millimeter psf2:psftype="Option">
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">80000</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">200000</psk:MediaSizeHeight>
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,80000,200000</psk12:PortraitImageableSize>
    </printsink:Receipt80Millimeter>
  </psk:PageMediaSize>
  <psk:PageOrientation psf2:psftype="Feature">
    <psk:Portrait psf2:psftype="Option" psf2:default="true" />
    <psk:Landscape psf2:psftype="Option" />
  </psk:PageOrientation>
  <psk:PageMediaType psf2:psftype="Feature">
    <printsink:ArchivePaper psf2:psftype="Option" />
    <printsink:ThermalReceiptMedia psf2:psftype="Option" />
  </psk:PageMediaType>
  <psk:JobInputBin psf2:psftype="Feature">
    <printsink:AutomationInputBin psf2:psftype="Option" />
  </psk:JobInputBin>
  <psk:JobOutputBin psf2:psftype="Feature">
    <printsink:AutomationOutputBin psf2:psftype="Option" />
  </psk:JobOutputBin>
  <psk:JobStapleAllDocuments psf2:psftype="Feature">
    <printsink:StapleUpperLeft psf2:psftype="Option" />
  </psk:JobStapleAllDocuments>
  <psk:JobPageOrder psf2:psftype="Feature">
    <printsink:OddPagesThenEvenPages psf2:psftype="Option" />
  </psk:JobPageOrder>
  <printsink:WatermarkMode psf2:psftype="Feature">
    <printsink:WatermarkOff psf2:psftype="Option" psf2:default="true" />
    <printsink:WatermarkText psf2:psftype="Option" />
    <printsink:WatermarkImage psf2:psftype="Option" />
  </printsink:WatermarkMode>
  <psk:PageResolution psf2:psftype="Feature">
    <printsink:Dpi600 psf2:psftype="Option" psf2:default="true">
      <psk:ResolutionX psf2:psftype="ScoredProperty" xsi:type="xsd:integer">600</psk:ResolutionX>
      <psk:ResolutionY psf2:psftype="ScoredProperty" xsi:type="xsd:integer">600</psk:ResolutionY>
    </printsink:Dpi600>
    <printsink:Dpi1200 psf2:psftype="Option">
      <psk:ResolutionX psf2:psftype="ScoredProperty" xsi:type="xsd:integer">1200</psk:ResolutionX>
      <psk:ResolutionY psf2:psftype="ScoredProperty" xsi:type="xsd:integer">1200</psk:ResolutionY>
    </printsink:Dpi1200>
  </psk:PageResolution>
  <psk:PageOutputColor psf2:psftype="Feature">
    <psk:Color psf2:psftype="Option" psf2:default="true">
      <psk:DeviceBitsPerPixel xsi:type="xsd:integer" psf2:psftype="ScoredProperty">24</psk:DeviceBitsPerPixel>
      <psk:DriverBitsPerPixel xsi:type="xsd:integer" psf2:psftype="ScoredProperty">24</psk:DriverBitsPerPixel>
    </psk:Color>
  </psk:PageOutputColor>
</psf2:PrintDeviceCapabilities>
